<div class="max-w-4xl mx-auto p-8">

  <.flash_messages flash={@flash} />

  <h1 class="text-3xl font-bold mb-8 text-gray-800 tracking-tight italic">
    File Processor Dashboard
  </h1>

  <.progress_bar
    stats={@stats}
    processing_started={@processing_started}
    all_done={@all_done}
    mode={@mode}
  />

  <.upload_form
    uploads={@uploads}
    mode={@mode}
    processing_started={@processing_started}
    all_done={@all_done}
  />

  <.metrics_dashboard
    stats={@stats}
    processing_started={@processing_started}
    all_done={@all_done}
    mode={@mode}
  />

  <.file_list
    id="my-file-list"
    streams={@streams}
    filter={@current_filter}
    expanded_error_file={@expanded_error_file}
    processing_started={@processing_started}
    all_done={@all_done}
    current_error_details={@current_error_details}
  />

  <.success_toast
    stats={@stats}
    total_rows={@total_rows}
    all_done={@all_done}
    mode={@mode}
    show_toast={@show_toast}
  />

  <%= if @all_done and @final_metrics do %>
    <.executive_summary
      all_done={@all_done}
      final_metrics={@final_metrics}
    />
  <% end %>
</div>
