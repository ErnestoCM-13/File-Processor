<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-3xl mx-auto space-y-6">
    <h1 class="text-3xl font-bold text-center text-slate-800 mb-10">File Processor</h1>

    <.form :let={_f} for={%{}} action={~p"/process"} method="post" enctype="multipart/form-data" id="upload-form">

      <% # CARD 1: Select files section %>
      <section class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8">
        <div class="flex items-center gap-3 mb-6">
          <div class="text-blue-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-800">Select Files</h2>
        </div>

        <label class="border-2 border-dashed border-slate-200 rounded-2xl p-12 flex flex-col items-center justify-center bg-slate-50 hover:bg-slate-100 transition-all cursor-pointer group">
          <div class="bg-white p-4 rounded-full shadow-sm mb-4 group-hover:scale-110 transition-transform">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-slate-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </div>
          <p class="font-semibold text-slate-700">Click to upload files</p>
          <p class="text-sm text-slate-400 mt-1">Supported files: .csv, .json, .log</p>

          <input type="file" id="file-input" name="files[]" multiple class="hidden" accept=".csv,.json,.log" required>
        </label>

        <% # Selected files area %>
        <div id="file-list-container" class="hidden mt-6 pt-6 border-t border-slate-50">
          <p class="text-sm font-bold text-slate-500 mb-3 uppercase tracking-wider">Selected files</p>
          <ul id="file-list" class="space-y-2"></ul>
        </div>
      </section>

      <% # CARD 2: Processing options%>
      <section class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8 mt-6">
        <div class="flex items-center gap-3 mb-6">
          <div class="text-blue-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12a7.5 7.5 0 0 0 15 0m-15 0a7.5 7.5 0 1 1 15 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077 1.41-.513m14.095-5.128 1.41-.513M5.106 17.785l1.15-.964m11.49-9.642 1.15-.964M10.864 3.527l.451 1.174m0 14.598-.451 1.174m6.22-15.146-.963 1.151m-9.155 10.936-.963 1.151m11.01-1.151-.964-1.15m-9.15 10.935-.964-1.15" />
            </svg>
          </div>
          <h2 class="text-xl font-bold text-slate-800">Processing Options</h2>
        </div>

        <p class="block text-sm font-bold text-slate-700 mb-2">Processing mode</p>

        <% # Processing mode buttons %>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
          <% # Sequential mode button %>
          <label class="relative border-2 border-slate-100 bg-white hover:border-blue-200 rounded-2xl p-4 cursor-pointer transition-all has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
            <input type="radio" name="mode" value="sequential" class="hidden" checked>
            <p class="font-bold text-slate-700">Sequential</p>
            <p class="text-xs text-slate-400">Process file by file</p>
          </label>

          <% # Parallel mode button %>
          <label class="relative border-2 border-slate-100 bg-white hover:border-blue-200 rounded-2xl p-4 cursor-pointer transition-all has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
            <input type="radio" name="mode" value="parallel" class="hidden">
            <p class="font-bold text-slate-700">Parallel</p>
            <p class="text-xs text-slate-400">Process using Elixir processes</p>
          </label>

          <% # Benchmark mode button %>
          <label class="relative border-2 border-slate-100 bg-white hover:border-blue-200 rounded-2xl p-4 cursor-pointer transition-all has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
            <input type="radio" name="mode" value="benchmark" class="hidden">
            <p class="font-bold text-slate-700">Benchmark</p>
            <p class="text-xs text-slate-400">Compares modes</p>
          </label>
        </div>

        <div class="grid grid-cols-2 gap-6 relative z-10">
          <% # Max workers imput %>
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">Max Workers:</label>
            <input type="number" name="workers" value="4" min="1" max="100" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all text-slate-800">
          </div>
          <% # Timeout imput %>
          <div>
            <label class="block text-sm font-bold text-slate-700 mb-2">Timeout (ms):</label>
            <input type="number" name="timeout" value="4000" min="100" step="100" class="w-full bg-white border border-slate-200 rounded-xl px-4 py-3 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all text-slate-800">
          </div>
        </div>
      </section>

      <% # Start processing button %>
      <button type="submit" id="submit-btn" disabled class="w-full mt-6 bg-blue-600 disabled:opacity-50 disabled:cursor-not-allowed hover:bg-blue-700 text-white font-bold py-4 rounded-2xl shadow-lg shadow-blue-200 transition-all flex items-center justify-center gap-3 active:scale-[0.98]">
        <div id="btn-content" class="flex items-center gap-3">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
            <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
          </svg>
          <span>Start Processing</span>
        </div>
      </button>
    </.form>
  </div>
</div>

<script>
  const fileInput = document.getElementById('file-input');
  const fileList = document.getElementById('file-list');
  const container = document.getElementById('file-list-container');
  const submitBtn = document.getElementById('submit-btn');
  const btnContent = document.getElementById('btn-content');
  const form = document.getElementById('upload-form');

  <%!--
  Logic for the slected files area.
    Will be replaced with LiveView.
  --%>
  fileInput.addEventListener('change', function() {
    fileList.innerHTML = '';

    if (this.files.length > 0) {
      container.classList.remove('hidden');
      submitBtn.disabled = false;

      Array.from(this.files).forEach(file => {
        const li = document.createElement('li');
        li.className = "flex items-center gap-2 text-slate-600 text-sm bg-slate-50 p-2 rounded-lg border border-slate-100";
        li.innerHTML = `
          <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
          ${file.name}
        `;
        fileList.appendChild(li);
      });
    } else {
      container.classList.add('hidden');
      submitBtn.disabled = true;
    }
  });

  <%!--
    Logic for changing the processing button icon.
    Will be replaced with LiveView.
  --%>
  form.addEventListener('submit', function() {
    btnContent.innerHTML = `
      <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <span>Processing...</span>
    `;
    submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
  });
</script>
