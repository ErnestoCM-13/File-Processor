<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-3xl mx-auto space-y-6">
    <h1 class="text-3xl font-bold text-center text-slate-800 mb-10">File Processor</h1>

    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8">
      <h2 class="text-xl font-bold text-slate-800 mb-6">Select Files</h2>

      <% # Drop zone %>
      <form id="upload-form" phx-change="validate" phx-drop-target={@uploads.files.ref}>
        <div class="border-2 border-dashed border-slate-200 rounded-2xl p-12 flex flex-col items-center justify-center bg-slate-50 hover:bg-slate-100 transition-all cursor-pointer">
          <.live_file_input upload={@uploads.files} class="hidden" />
          <div class="bg-white p-4 rounded-full shadow-sm mb-4">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-8 h-8 text-slate-400">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
          </div>
          <p class="font-semibold text-slate-700">Click or drag files here</p>
          <p class="text-sm text-slate-400 mt-1">Supported: .csv, .json, .log</p>
        </div>
      </form>

      <% # file list %>
      <div class="mt-6 space-y-3">
        <%= for entry <- @uploads.files.entries do %>
          <div class="flex items-center justify-between bg-blue-50 p-3 rounded-xl border border-blue-100">
            <div class="flex items-center gap-3">
              <svg class="w-5 h-5 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                <path d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z"/>
              </svg>
              <span class="text-sm font-medium text-slate-700"><%= entry.client_name %></span>
            </div>

            <% # Individual progress bar %>
            <div class="w-24 bg-slate-200 rounded-full h-1.5 overflow-hidden">
              <div class="bg-blue-500 h-full transition-all" style={"width: #{entry.progress}%"}></div>
            </div>

            <button phx-click="cancel-upload" phx-value-ref={entry.ref} class="text-slate-400 hover:text-red-500">
              &times;
            </button>
          </div>
        <% end %>
      </div>
    </div>



    <% # Options CARD %>
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 p-8">
      <p class="text-sm font-semibold text-slate-500 mb-4">Processing mode</p>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
        <% # Sequential %>
        <div phx-click="select-mode" phx-value-mode="sequential"
             class={"border-2 rounded-2xl p-4 cursor-pointer transition-all #{if @mode == "sequential", do: "border-blue-500 bg-blue-50", else: "border-slate-100 bg-white"}"}>
          <p class={"font-bold #{if @mode == "sequential", do: "text-blue-700", else: "text-slate-700"}"}>Sequential</p>
          <p class="text-xs text-slate-400">Process file by file</p>
        </div>

        <% # Parallel %>
        <div phx-click="select-mode" phx-value-mode="parallel"
             class={"border-2 rounded-2xl p-4 cursor-pointer transition-all #{if @mode == "parallel", do: "border-blue-500 bg-blue-50", else: "border-slate-100 bg-white"}"}>
          <p class={"font-bold #{if @mode == "parallel", do: "text-blue-700", else: "text-slate-700"}"}>Parallel</p>
          <p class="text-xs text-slate-400">Use Elixir processes</p>
        </div>

        <% # Benchmark %>
        <div phx-click="select-mode" phx-value-mode="benchmark"
             class={"border-2 rounded-2xl p-4 cursor-pointer transition-all #{if @mode == "benchmark", do: "border-blue-500 bg-blue-50", else: "border-slate-100 bg-white"}"}>
          <p class={"font-bold #{if @mode == "benchmark", do: "text-blue-700", else: "text-slate-700"}"}>Benchmark</p>
          <p class="text-xs text-slate-400">Compare modes</p>
        </div>
      </div>
    </div>

    <button
      phx-click="start-processing"
      disabled={@loading or Enum.empty?(@uploads.files.entries)}
      class={"w-full font-bold py-4 rounded-2xl shadow-lg transition-all flex items-center justify-center gap-3 #{if @loading, do: "bg-blue-300 cursor-not-allowed", else: "bg-blue-600 hover:bg-blue-700 text-white"}"}
    >
      <%= if @loading do %>
        <div class="animate-spin h-5 w-5 border-2 border-white border-t-transparent rounded-full"></div>
        Processing...
      <% else %>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6">
          <path fill-rule="evenodd" d="M4.5 5.653c0-1.427 1.529-2.33 2.779-1.643l11.54 6.347c1.295.712 1.295 2.573 0 3.286L7.28 19.99c-1.25.687-2.779-.217-2.779-1.643V5.653Z" clip-rule="evenodd" />
        </svg>
        Start Processing
      <% end %>
    </button>
  </div>
</div>
