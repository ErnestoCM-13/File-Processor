<div class="min-h-screen bg-slate-100 p-12">
  <div class="max-w-5xl mx-auto space-y-10">

    <div class="flex items-center gap-4 mb-12">
      <a href="/metrics" class="text-slate-900 hover:text-blue-600 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-7 h-7">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
        </svg>
      </a>
      <h1 class="text-4xl font-bold text-slate-900 tracking-tight">Errors</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white p-8 rounded-2xl shadow-xl shadow-slate-200/50 flex flex-col justify-between h-40 relative overflow-hidden">
        <div class="flex justify-between items-start">
          <div class="border-2 border-slate-300 rounded-full p-1 text-slate-400">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg>
          </div>
          <span class="text-5xl font-bold text-slate-800"><%= @counts.total %></span>
        </div>
        <p class="text-slate-500 font-bold text-sm">Total Error Files</p>
      </div>

      <div class="bg-white p-8 rounded-2xl shadow-xl shadow-slate-200/50 flex flex-col justify-between h-40">
        <div class="flex justify-between items-start">
          <div class="border-2 border-orange-500 rounded-full p-1 text-orange-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" /></svg>
          </div>
          <span class="text-5xl font-bold text-slate-800"><%= @counts.critical %></span>
        </div>
        <p class="text-slate-500 font-bold text-sm">Critical Error Files</p>
      </div>

      <div class="bg-white p-8 rounded-2xl shadow-xl shadow-slate-200/50 flex flex-col justify-between h-40">
        <div class="flex justify-between items-start">
          <div class="border-2 border-yellow-500 rounded-full p-1 text-yellow-500">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z" /></svg>
          </div>
          <span class="text-5xl font-bold text-slate-800"><%= @counts.invalid %></span>
        </div>
        <p class="text-slate-500 font-bold text-sm">Invalid Entries Files</p>
      </div>
    </div>

    <div class="bg-white rounded-[2.5rem] p-10 shadow-xl shadow-slate-200/50 min-h-[500px]">
      <h2 class="text-2xl font-bold text-slate-800 mb-8 tracking-tight">Error Details</h2>

      <div class="space-y-6">
        <%= for error <- @errors do %>
          <div class={["p-6 rounded-2xl border-2 transition-all",
            if(error.type == :critical, do: "bg-red-50/50 border-red-500", else: "bg-orange-50/30 border-yellow-500")]}>

            <div class="flex items-start gap-4">
              <div class={if(error.type == :critical, do: "text-red-500", else: "text-yellow-500")}>
                <%= if error.type == :critical do %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path fill-rule="evenodd" d="M2.25 12c0-5.385 4.365-9.75 9.75-9.75s9.75 4.365 9.75 9.75-4.365 9.75-9.75 9.75S2.25 17.385 2.25 12zm8.706-1.442c1.146-.573 2.437.463 2.126 1.706l-.709 2.836.042-.02a.75.75 0 01.67 1.34l-.04.022c-1.147.573-2.438-.463-2.127-1.706l.71-2.836-.042.02a.75.75 0 11-.671-1.34l.041-.022zM12 9a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
                <% else %>
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path fill-rule="evenodd" d="M9.401 3.003c1.155-2 4.043-2 5.197 0l7.355 12.748c1.154 2-.29 4.5-2.599 4.5H4.645c-2.309 0-3.752-2.5-2.598-4.5L9.401 3.003zM12 8.25a.75.75 0 01.75.75v3.75a.75.75 0 01-1.5 0V9a.75.75 0 01.75-.75zm0 8.25a.75.75 0 100-1.5.75.75 0 000 1.5z" clip-rule="evenodd" /></svg>
                <% end %>
              </div>

              <div class="flex-1">
                <h3 class="font-bold text-slate-800 text-lg">File: <%= error.file %></h3>

                <%= if Map.has_key?(error, :msg) do %>
                  <p class="text-slate-600 mt-1"><%= error.msg %></p>
                <% end %>

                <%= if Map.has_key?(error, :details) do %>
                  <ul class="mt-3 space-y-1">
                    <%= for line <- error.details do %>
                      <li class="text-slate-600 text-sm flex items-center gap-2">
                        <span class="w-1 h-1 bg-slate-400 rounded-full"></span>
                        <%= line %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
