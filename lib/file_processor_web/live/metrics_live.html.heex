<div class="max-w-4xl mx-auto p-8">
  <h1 class="text-3xl font-bold mb-8">File Processor Dashboard</h1>

  <%!-- Step 2: Mode Selection & Configuration --%>
  <div class="bg-white p-6 rounded-xl shadow-sm border mb-8">
    <form phx-change="change_mode" phx-submit="start_processing" class="space-y-4">
      <div class="flex items-center gap-6">
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="radio" name="mode" value="sequential" checked={@mode == :sequential} class="text-indigo-600" />
          <span class="text-sm font-medium">Sequential</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="radio" name="mode" value="parallel" checked={@mode == :parallel} class="text-indigo-600" />
          <span class="text-sm font-medium">Parallel</span>
        </label>
        <label class="flex items-center gap-2 cursor-pointer">
          <input type="radio" name="mode" value="benchmark" checked={@mode == :benchmark} class="text-indigo-600" />
          <span class="text-sm font-medium">Benchmark</span>
        </label>
      </div>

      <%!-- Step 2: Contextual Config (Visible if not sequential) --%>
      <div :if={@mode != :sequential} class="p-4 bg-indigo-50 rounded-lg border border-indigo-100 animate-fade-in">
        <label class="block text-xs font-semibold text-indigo-700 uppercase mb-1">Worker Configuration</label>
        <input type="number" name="workers" placeholder="Number of workers (e.g. 4)" class="w-full rounded-md border-gray-200 text-sm" />
      </div>

      <button type="submit" disabled={@processing_started} class="w-full py-3 bg-indigo-600 text-white font-bold rounded-lg hover:bg-indigo-700 disabled:opacity-50 transition-all">
        <%= if @processing_started, do: "Processing...", else: "Start File Analysis" %>
      </button>
    </form>
  </div>

  <%!-- Step 3 & 5: Unified Metrics View --%>
  <div :if={@processing_started or @all_done} class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <%!-- Processed Card --%>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-l-4 border-l-green-500">
      <p class="text-xs font-bold text-gray-400 uppercase">Processed</p>
      <div :if={@processing_started && !@all_done} class="h-8 w-16 bg-gray-100 animate-pulse mt-2 rounded"></div>
      <p :if={@all_done} class="text-3xl font-black text-gray-800 mt-1"><%= @stats.processed %></p>
    </div>

    <%!-- Errors Card --%>
    <div class="bg-white p-6 rounded-xl shadow-sm border border-l-4 border-l-red-500">
      <p class="text-xs font-bold text-gray-400 uppercase">Errors</p>
      <div :if={@processing_started && !@all_done} class="h-8 w-16 bg-gray-100 animate-pulse mt-2 rounded"></div>
      <p :if={@all_done} class="text-3xl font-black text-gray-800 mt-1"><%= @stats.errors %></p>
    </div>

    <%!-- Success Rate (Donut Placeholder) --%>
    <div class="bg-white p-6 rounded-xl shadow-sm border flex items-center justify-between">
       <div>
         <p class="text-xs font-bold text-gray-400 uppercase">Success Rate</p>
         <p :if={@all_done} class="text-2xl font-black text-indigo-600 mt-1">85%</p>
       </div>
       <%!-- Future Donut Component will go here --%>
       <div class="w-12 h-12 rounded-full border-4 border-indigo-100 border-t-indigo-600 animate-spin" :if={@processing_started && !@all_done}></div>
    </div>
  </div>

  <%!-- Step 7: File List & Filters --%>
  <div class="bg-white rounded-xl shadow-sm border overflow-hidden">
    <div class="p-4 border-b bg-gray-50 flex justify-between items-center">
      <h3 class="font-bold text-gray-700">Processed Files</h3>
      <div class="flex gap-2">
        <button disabled={!@all_done} class="px-3 py-1 text-xs font-medium rounded-full bg-gray-200 disabled:opacity-30">All</button>
        <button disabled={!@all_done} class="px-3 py-1 text-xs font-medium rounded-full bg-red-100 text-red-600 disabled:opacity-30">Errors</button>
      </div>
    </div>
    <ul class="divide-y divide-gray-100">
      <li :for={file <- @files} class="p-4 flex justify-between items-center">
        <span class="text-sm text-gray-600"><%= file.name %></span>
        <span class={"text-xs font-bold px-2 py-1 rounded #{if file.status == :ok, do: "bg-green-100 text-green-700", else: "bg-red-100 text-red-700"}"}>
          <%= String.upcase(Atom.to_string(file.status)) %>
        </span>
      </li>
      <li :if={Enum.empty?(@files)} class="p-8 text-center text-gray-400 text-sm">
        No files processed yet.
      </li>
    </ul>
  </div>
</div>