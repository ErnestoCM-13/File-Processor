<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-5xl mx-auto space-y-8">

    <div class="flex justify-between items-center">
      <div class="flex items-center gap-4">
        <a href="/" class="text-slate-400 hover:text-slate-600">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
        </a>
        <h1 class="text-3xl font-bold text-slate-800">Metrics Report</h1>
      </div>
      <div class="flex gap-3">
        <button class="bg-blue-600 text-white px-6 py-2 rounded-xl font-bold shadow-lg shadow-blue-100">
          Download Report
        </button>
        <% # Send ID to errors page %>
        <a href={~p"/errors?id=#{@id}"} class="bg-orange-600 text-white px-6 py-2 rounded-xl font-bold shadow-lg shadow-orange-100">
          View Errors
        </a>
      </div>
    </div>

    <% # Performance Analysis section %>
    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
      <div class="flex items-center gap-3 mb-6 text-blue-500">
        <h2 class="text-xl font-bold text-slate-800">Performance Analysis</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-2">
          <div class="flex justify-between p-3 bg-slate-50 rounded-lg">
            <span class="text-slate-500 text-sm">Sequential time:</span>
            <span class="text-slate-800 font-mono font-medium"><%= @results.performance.sequential %></span>
          </div>
          <div class="flex justify-between p-3 bg-slate-50 rounded-lg">
            <span class="text-slate-500 text-sm">Parallel time:</span>
            <span class="text-slate-800 font-mono font-medium"><%= @results.performance.parallel %></span>
          </div>
        </div>

        <div class="bg-green-50 border border-green-100 rounded-2xl p-8 text-center">
          <p class="text-green-600 text-sm font-semibold mb-1">Improvement:</p>
          <p class="text-2xl font-black text-green-600"><%= @results.performance.improvement %></p>
        </div>
      </div>
    </div>

    <% # JSON files section example %>
    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 mt-8">
      <div class="flex items-center gap-3 mb-8 text-purple-500">
        <h2 class="text-xl font-bold text-slate-800">JSON Files Metrics</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <%= for file <- @results.json_files do %>
          <div>
            <h3 class="font-bold text-slate-700 mb-4 text-sm uppercase tracking-wider">File: <%= file.name %></h3>
            <div class="space-y-1">
              <.metric_row label="Total objects found" value={file.total_objects} />
              <.metric_row label="Top email domain" value={file.top_domain} />
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
