<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-5xl mx-auto space-y-8">

    <div class="flex justify-between items-center">
      <div class="flex items-center gap-4">
        <.link navigate={~p"/"} class="text-slate-400 hover:text-slate-600">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
          </svg>
        </.link>
        <h1 class="text-3xl font-bold text-slate-800">Metrics Report</h1>
      </div>
      <div class="flex gap-3">
        <button class="bg-blue-600 text-white px-6 py-2 rounded-xl font-bold flex items-center gap-2 shadow-lg shadow-blue-100">
          Download Report
        </button>
        <.link navigate={~p"/errors"} class="bg-orange-600 text-white px-6 py-2 rounded-xl font-bold shadow-lg shadow-orange-100">
          View Errors
        </.link>
      </div>
    </div>

    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
      <div class="flex items-center gap-3 mb-6 text-blue-500">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z" />
        </svg>
        <h2 class="text-xl font-bold text-slate-800">Performance Analysis</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-center">
        <div class="space-y-2">
          <%= for {label, value} <- [{"Sequential time:", @performance.sequential}, {"Parallel time:", @performance.parallel}, {"Processes used:", @performance.processes}, {"Memory used:", @performance.memory}] do %>
            <div class="flex justify-between p-3 bg-slate-50 rounded-lg">
              <span class="text-slate-500 text-sm"><%= label %></span>
              <span class="text-slate-800 font-mono font-medium"><%= value %></span>
            </div>
          <% end %>
        </div>

        <div class="bg-green-50 border border-green-100 rounded-2xl p-8 text-center">
          <p class="text-green-600 text-sm font-semibold mb-1">Improvement:</p>
          <p class="text-2xl font-black text-green-600"><%= @performance.improvement %></p>
        </div>
      </div>
    </div>

    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
      <div class="flex items-center gap-3 mb-8 text-blue-500">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z" />
        </svg>
        <h2 class="text-xl font-bold text-slate-800">CSV Files Metrics</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <div>
          <h3 class="font-bold text-slate-700 mb-4 text-sm uppercase tracking-wider">File: ventas_enero.csv</h3>
          <div class="space-y-1">
            <.metric_row label="Total sales" value="$24399.93" />
            <.metric_row label="Unique products" value="15" />
            <.metric_row label="Top product" value="Cable HDMI (40 units)" />
            <.metric_row label="Top category" value="Computadoras ($10289.91)" />
            <.metric_row label="Average discount" value="12.0" />
            <.metric_row label="Date range" value="2024-01-02 to 2024-01-30" />
          </div>
        </div>

        <div>
          <h3 class="font-bold text-slate-700 mb-4 text-sm uppercase tracking-wider">File: ventas_febrero.csv</h3>
          <div class="space-y-1">
            <.metric_row label="Total sales" value="$26721.37" />
            <.metric_row label="Unique products" value="16" />
            <.metric_row label="Top product" value="Cable Ethernet Cat6 (30 units)" />
            <.metric_row label="Top category" value="Computadoras ($13049.89)" />
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 mt-8">
      <div class="flex items-center gap-3 mb-8 text-orange-500">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z" />
        </svg>
        <h2 class="text-xl font-bold text-slate-800">Log Files Metrics</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <div>
          <h3 class="font-bold text-slate-700 mb-4 text-sm uppercase tracking-wider">File: system_auth.log</h3>
          <div class="space-y-1">
            <.metric_row label="Total lines processed" value="1,240" />
            <.metric_row label="ERROR level" value="15% (186 events)" class="text-red-600" />
            <.metric_row label="INFO level" value="70% (868 events)" class="text-blue-600" />
            <.metric_row label="DEBUG level" value="15% (186 events)" class="text-slate-400" />
            <.metric_row label="Critical keywords found" value="'failed', 'denied'" />
          </div>
        </div>

        <div>
          <h3 class="font-bold text-slate-700 mb-4 text-sm uppercase tracking-wider">File: server_access.log</h3>
          <div class="space-y-1">
            <.metric_row label="Total lines processed" value="5,500" />
            <.metric_row label="Top IP Source" value="192.168.1.45" />
            <.metric_row label="Most requested path" value="/api/v1/users" />
          </div>
        </div>
      </div>
    </div>

    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 mt-8">
      <div class="flex items-center gap-3 mb-8 text-purple-500">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.25 9.75 16.5 12l-2.25 2.25m-4.5 0L7.5 12l2.25-2.25M6 20.25h12A2.25 2.25 0 0 0 20.25 18V6A2.25 2.25 0 0 0 18 3.75H6A2.25 2.25 0 0 0 3.75 6v12A2.25 2.25 0 0 0 6 20.25Z" />
        </svg>
        <h2 class="text-xl font-bold text-slate-800">JSON Files Metrics</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 gap-y-10">
        <%= for file <- @json_files do %>
          <div>
            <h3 class="font-bold text-slate-700 mb-4 text-sm uppercase tracking-wider">File: <%= file.name %></h3>
            <div class="space-y-1">
              <.metric_row label="Total objects found" value={file.total_objects} />
              <.metric_row label="Top email domain" value={file.top_domain} />
              <.metric_row label="Unique user roles" value={file.unique_roles} />
              <.metric_row label="Average age" value={file.avg_age} />
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
