<div class="min-h-screen bg-slate-50 p-8">
  <div class="max-w-5xl mx-auto space-y-8">

    <% # Header section %>
    <div class="flex items-center gap-4 mb-12">
      <a href="/metrics" class="text-slate-900 hover:text-blue-600 transition-colors">
        <.icon name="hero-arrow-left" class="w-7 h-7 text-slate-600" />
      </a>
      <h1 class="text-3xl font-bold text-slate-800">Errors</h1>
    </div>

    <% # Error summary section %>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm grid grid-cols-2 grid-rows-2 items-start">
        <.icon name="hero-x-circle" class="w-7 h-7 text-slate-500 justify-self-start" />
        <span class="text-2xl font-bold text-slate-800 justify-self-end"><%= @counts.total %></span>
        <p class="text-slate-400 text-xs font-bold uppercase tracking-widest col-span-2 self-end">Total Error Files</p>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm grid grid-cols-2 grid-rows-2 items-start">
        <.icon name="hero-exclamation-circle" class="w-7 h-7 text-orange-600 justify-self-start" />
        <span class="text-2xl font-bold text-slate-800 justify-self-end"><%= @counts.critical %></span>
        <p class="text-slate-400 text-xs font-bold uppercase tracking-widest col-span-2 self-end">Critical Error Files</p>
      </div>

      <div class="bg-white p-6 rounded-2xl border border-slate-100 shadow-sm grid grid-cols-2 grid-rows-2 items-start">
        <.icon name="hero-exclamation-triangle" class="w-7 h-7 text-yellow-500 justify-self-start" />
        <span class="text-2xl font-bold text-slate-800 justify-self-end"><%= @counts.invalid %></span>
        <p class="text-slate-400 text-xs font-bold uppercase tracking-widest col-span-2 self-end">Invalid Entries Files</p>
      </div>
    </div>

    <% # Error details section %>
    <div class="bg-white rounded-[2.5rem] p-10 shadow-xl shadow-slate-200/50 min-h-[500px]">
      <h2 class="text-2xl font-bold text-slate-800 mb-8">Error Details</h2>

      <div class="space-y-6">
        <%= for error <- @errors do %>
          <div class={["p-6 rounded-2xl border-2 transition-all",
            if(error.type == :critical, do: "bg-orange-50/50 border-orange-600", else: "bg-yellow-50/30 border-yellow-500")]}>

            <div class="flex items-start gap-4">
              <div class={if(error.type == :critical, do: "text-orange-600", else: "text-yellow-500")}>
                <%= if error.type == :critical do %>
                  <.icon name="hero-exclamation-circle" class="w-7 h-7 text-orange-600" />
                <% else %>
                  <.icon name="hero-exclamation-triangle" class="w-7 h-7 text-yellow-500 justify-self-start" />
                <% end %>
              </div>

              <div class="flex-1">
                <h3 class="font-bold text-slate-800 text-lg">File: <%= error.file %></h3>

                <%= if Map.has_key?(error, :msg) do %>
                  <p class="text-slate-600 mt-1"><%= error.msg %></p>
                <% end %>

                <%= if Map.has_key?(error, :details) do %>
                  <ul class="mt-3 space-y-1">
                    <%= for line <- error.details do %>
                      <li class="text-slate-600 text-sm flex items-center gap-2">
                        <span class="w-1 h-1 bg-slate-400 rounded-full"></span>
                        <%= line %>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</div>
